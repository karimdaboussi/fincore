{
  "name": "fincore-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "test:guide": "node tests/architecture-guide.mjs",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.6",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "22.18.12",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
